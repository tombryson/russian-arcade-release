  {"id":"es","upper":"С","lower":"с","name":"эс","nameAudio":{"female":"/static/audio/alphabet-v1/es-name.mp3","male":"/static/audio/alphabet-v1/male/es-name.mp3"},"example":"сок","exampleMeaning":"juice","exampleAudio":{"female":"/static/audio/alphabet-v1/es-word.mp3","male":"/static/audio/alphabet-v1/male/es-word.mp3"},"kind":"consonant","note":"Like s in sun. С can be hard or soft; it does not stand for k.","soundIpa":"sa","soundAudio":{"female":"/static/audio/alphabet-v1/sounds/female/es-sound.mp3","male":"/static/audio/alphabet-v1/sounds/male/es-sound.mp3"},"practiceSyllable":"са"},
  {"id":"te","upper":"Т","lower":"т","name":"тэ","nameAudio":{"female":"/static/audio/alphabet-v1/te-name.mp3","male":"/static/audio/alphabet-v1/male/te-name.mp3"},"example":"торт","exampleMeaning":"cake","exampleAudio":{"female":"/static/audio/alphabet-v1/te-word.mp3","male":"/static/audio/alphabet-v1/male/te-word.mp3"},"kind":"consonant","note":"A short t sound made near the upper teeth, with little puff of air. Т can also be soft.","soundIpa":"ta","soundAudio":{"female":"/static/audio/alphabet-v1/sounds/female/te-sound.mp3","male":"/static/audio/alphabet-v1/sounds/male/te-sound.mp3"},"practiceSyllable":"та"},
