  {"id":"a","upper":"А","lower":"а","name":"а","nameAudio":{"female":"/static/audio/alphabet-v1/a-name.mp3","male":"/static/audio/alphabet-v1/male/a-name.mp3"},"example":"арбу́з","exampleMeaning":"watermelon","exampleAudio":{"female":"/static/audio/alphabet-v1/a-word.mp3","male":"/static/audio/alphabet-v1/male/a-word.mp3"},"kind":"vowel","note":"An open ah sound when stressed. Unstressed а is shorter.","soundIpa":"a","soundAudio":{"female":"/static/audio/alphabet-v1/sounds/female/a-sound.mp3","male":"/static/audio/alphabet-v1/sounds/male/a-sound.mp3"},"practiceSyllable":null},
