  {"id":"el","upper":"Л","lower":"л","name":"эль","nameAudio":{"female":"/static/audio/alphabet-v1/el-name.mp3","male":"/static/audio/alphabet-v1/male/el-name.mp3"},"example":"ла́мпа","exampleMeaning":"lamp","exampleAudio":{"female":"/static/audio/alphabet-v1/el-word.mp3","male":"/static/audio/alphabet-v1/male/el-word.mp3"},"kind":"consonant","note":"A hard l sound, with the back of the tongue raised. Л also has a softer sound in other words.","soundIpa":"ɫa","soundAudio":{"female":"/static/audio/alphabet-v1/sounds/female/el-sound.mp3","male":"/static/audio/alphabet-v1/sounds/male/el-sound.mp3"},"practiceSyllable":"ла"},
