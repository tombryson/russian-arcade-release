[
  {"id":"a","upper":"А","lower":"а","name":"а","nameAudio":{"female":"/static/audio/alphabet-v1/a-name.mp3","male":"/static/audio/alphabet-v1/male/a-name.mp3"},"example":"арбу́з","exampleMeaning":"watermelon","exampleAudio":{"female":"/static/audio/alphabet-v1/a-word.mp3","male":"/static/audio/alphabet-v1/male/a-word.mp3"},"kind":"vowel","note":"The name is ah. In words, stressed а is an open ah; unstressed а is shorter."},
