  {"id":"o","upper":"О","lower":"о","name":"о","nameAudio":{"female":"/static/audio/alphabet-v1/o-name.mp3","male":"/static/audio/alphabet-v1/male/o-name.mp3"},"example":"о́блако","exampleMeaning":"cloud","exampleAudio":{"female":"/static/audio/alphabet-v1/o-word.mp3","male":"/static/audio/alphabet-v1/male/o-word.mp3"},"kind":"vowel","note":"A steady rounded o when stressed, without the English oh glide. Unstressed о often sounds closer to ah.","soundIpa":"o","soundAudio":{"female":"/static/audio/alphabet-v1/sounds/female/o-sound.mp3","male":"/static/audio/alphabet-v1/sounds/male/o-sound.mp3"},"practiceSyllable":null},
