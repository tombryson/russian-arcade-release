  {"id":"shcha","upper":"Щ","lower":"щ","name":"ща","nameAudio":{"female":"/static/audio/alphabet-v1/shcha-name.mp3","male":"/static/audio/alphabet-v1/male/shcha-name.mp3"},"example":"щётка","exampleMeaning":"brush","exampleAudio":{"female":"/static/audio/alphabet-v1/shcha-word.mp3","male":"/static/audio/alphabet-v1/male/shcha-word.mp3"},"kind":"consonant","note":"A long, soft sh sound. Щ is different from the harder ш.","soundIpa":"ɕː","soundAudio":{"female":"/static/audio/alphabet-v1/sounds/female/shcha-sound.mp3","male":"/static/audio/alphabet-v1/sounds/male/shcha-sound.mp3"},"practiceSyllable":null},
  {"id":"hard-sign","upper":"Ъ","lower":"ъ","name":"твёрдый знак","nameAudio":{"female":"/static/audio/alphabet-v1/hard-sign-name.mp3","male":"/static/audio/alphabet-v1/male/hard-sign-name.mp3"},"example":"объе́кт","exampleMeaning":"object","exampleAudio":{"female":"/static/audio/alphabet-v1/hard-sign-word.mp3","male":"/static/audio/alphabet-v1/male/hard-sign-word.mp3"},"kind":"sign","note":"Ъ separates a consonant from the y sound in е, ё, ю or я. Hear how it works in объе́кт.","soundIpa":null,"soundAudio":null,"practiceSyllable":null},
  {"id":"yery","upper":"Ы","lower":"ы","name":"ы","nameAudio":{"female":"/static/audio/alphabet-v1/yery-name.mp3","male":"/static/audio/alphabet-v1/male/yery-name.mp3"},"example":"сыр","exampleMeaning":"cheese","exampleAudio":{"female":"/static/audio/alphabet-v1/yery-word.mp3","male":"/static/audio/alphabet-v1/male/yery-word.mp3"},"kind":"vowel","note":"No exact English equivalent. Keep your lips unrounded and your tongue farther back than for и.","soundIpa":"ɨ","soundAudio":{"female":"/static/audio/alphabet-v1/sounds/female/yery-sound.mp3","male":"/static/audio/alphabet-v1/sounds/male/yery-sound.mp3"},"practiceSyllable":null},
  {"id":"soft-sign","upper":"Ь","lower":"ь","name":"мя́гкий знак","nameAudio":{"female":"/static/audio/alphabet-v1/soft-sign-name.mp3","male":"/static/audio/alphabet-v1/male/soft-sign-name.mp3"},"example":"дверь","exampleMeaning":"door","exampleAudio":{"female":"/static/audio/alphabet-v1/soft-sign-word.mp3","male":"/static/audio/alphabet-v1/male/soft-sign-word.mp3"},"kind":"sign","note":"In дверь, ь makes р soft. In other words, it can separate sounds or mark grammar.","soundIpa":null,"soundAudio":null,"practiceSyllable":null},
