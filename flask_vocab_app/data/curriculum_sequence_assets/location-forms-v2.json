  "content": {
    "items": [
      {
        "id": "school-destination",
        "type": "controlled_text",
        "prompt": "— Куда ты идёшь?\n— Я иду в ___. (школа)",
        "answer": "школу",
        "accepted_answers": [
          "школу",
          "в школу"
        ],
        "hint": "A destination: школа changes to школу.",
        "explanation": "В школу gives the destination.",
        "hint_ru": "Куда? Здесь слово «школа» меняется на «школу».",
        "explanation_ru": "«В школу» — цель движения: куда ты идёшь."
      },
      {
        "id": "library-location",
        "type": "controlled_text",
        "prompt": "Я сейчас в ___. (библиотека)",
        "answer": "библиотеке",
        "accepted_answers": [
          "библиотеке",
          "в библиотеке"
        ],
        "hint": "A current location uses библиотеке here.",
        "explanation": "В библиотеке gives the current place.",
        "hint_ru": "Где? Здесь нужна форма «библиотеке».",
        "explanation_ru": "«В библиотеке» — место, где ты сейчас находишься."
      },
      {
        "id": "park-meeting",
        "type": "controlled_text",
        "prompt": "Встретимся в ___. (парк)",
        "answer": "парке",
        "accepted_answers": [
          "парке",
          "в парке"
        ],
        "hint": "The meeting takes place inside the park.",
        "explanation": "В парке gives the meeting place.",
        "hint_ru": "Встреча будет внутри парка. Где?",
        "explanation_ru": "«В парке» — место встречи."
      }
    ]
  },
