# Russian Vocab — environment variables
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored. NEVER commit real keys.

# --- Required: API keys ---
# Rotate these from the provider dashboards before pasting.
OPENAI_API_KEY=
YANDEX_API_KEY=
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=

# Conversation pilot: independent of story and flashcard model choices.
CONVERSATION_TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2
CONVERSATION_COMPARISON_MODEL=gpt-transcribe
CONVERSATION_MODEL=gpt-5.6-luna
LIVE_CONVERSATION_MODEL=gpt-live-1
LIVE_CONVERSATION_VOICES=marin,cedar
FORVO_API_KEY=

# Flask session signing key. Any random 32+ char string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# --- Optional: local paths (relative paths resolve from the repository root) ---
# Anki media directory. Default: ~/Library/Application Support/Anki2/User 1/collection.media
# ANKI_MEDIA_DIR=

# Vocab DB path. Default: flask_vocab_app/vocab.db
# Use instance/vocab.dev.db for development, separate from your learning data.
# VOCAB_DB_PATH=

# AnkiConnect endpoint. Default: http://localhost:8765
# ANKI_CONNECT_URL=

# Default Anki deck name. Default: Russian
# ANKI_DEFAULT_DECK=

# Application media is separate from Anki's media directory.
# APP_MEDIA_DIR=instance/media
# VOCAB_UPLOAD_DIR=instance/uploads
# VOCAB_SESSION_DIR=instance/sessions

# Drive capture file and OAuth artifacts. Existing paths/file ID remain the defaults.
# GOOGLE_DRIVE_FILE_ID=
# GOOGLE_DRIVE_CREDENTIALS_FILE=flask_vocab_app/credentials.json
# GOOGLE_DRIVE_TOKEN_FILE=flask_vocab_app/token.json
# GOOGLE_DRIVE_CACHE_FILE=flask_vocab_app/vocab_list_cache.txt
GOOGLE_DRIVE_AUTO_AUTH=false

# Hosted sign-in. Separate from Google Drive's local capture credentials.
# Configure these through Fly secrets for the hosted deployment.
# At least one complete provider pair is required when accounts are enabled.
# HOSTED_ACCOUNTS_ENABLED=true
# HOSTED_GUEST_DEMO_ENABLED=true  # /demo: separate 24-hour visitor workspaces
# HOSTED_TRIAL_ROOT=/data/trial
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Google web-client callback: https://russian-arcade.fly.dev/trial/callback/google
# Existing GitHub callback: https://russian-arcade.fly.dev/trial/callback

# Model overrides. These defaults are not checked for provider/account availability.
# Native and Anki card text generation (direct OpenAI API model ID).
OPENAI_MODEL_FLASHCARDS=gpt-5.6-luna
OPENAI_MODEL_HIGH=gpt-5.2
OPENAI_MODEL_STORY=gpt-6-astra
OPENAI_STORY_REASONING_EFFORT=low
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_VISION=gpt-5.2
OPENAI_IMAGE_MODEL=gpt-image-2

# Preact interface at /; optional Anki tools at /tools/anki/.
WORD_POST_ENABLED=true
# New learners use the published A1 journey. Existing enrolments stay pinned.
# COURSE_DEFAULT_RELEASE=a1-v1
WORD_POST_CATALOGUE_ENABLED=false
# WORD_POST_DIST_DIR=flask_vocab_app/ui/dist

# Optional household controls. Individual flashcards work with this disabled.
# Only for household mode: run db-upgrade and word-post setup first.
# Requires a private FLASK_SECRET_KEY of at least 32 characters; loopback only.
WORD_POST_HOUSEHOLD_ENABLED=false
# Native automatic generation and study: requires schema 10, no household setup.
# Set before first personal study; defines the daily new-card reset.
# PERSONAL_STUDY_TIMEZONE=Australia/Melbourne
NATIVE_FLASHCARDS_ENABLED=true
# WORD_POST_ASSET_DIR=instance/word-post-assets

# Randomly choose a voice for each generation to provide listening variety.
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_IDS=ymDCYd8puC7gYjxIamPt,gXMhWmiqsFkrcssqVb5k,sRk0zCqhS2Cmv0bzx5wA,3EuKHIEZbSzrHGNmdYsx
